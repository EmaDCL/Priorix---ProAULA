# Ignorar carpeta de compilación
target/
*.class

# Ignorar archivos de configuración de VS Code (aquí están tus variables env)
.vscode/

# Ignorar archivos de variables de entorno
.env

# Ignorar logs
*.log

# Crea o sobreescribe el .gitignore en la raíz
echo ".vscode/" > .gitignore
echo ".env" >> .gitignore
echo "target/" >> .gitignore
echo "*.log" >> .gitignore